# =============================================================================
# IDRM — DEVELOPMENT environment variables (safe local defaults).
#
# ⚠️  These are DEV-ONLY values. NEVER use them in staging/production, and NEVER
#     commit real secrets. Staging/production read from .env.staging / .env.production
#     (both git-ignored). The production setup script refuses to start if it still
#     sees the placeholder secret/password below.
# =============================================================================

# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Database (PostgreSQL 16 + PostGIS 3.4) ---
DB_NAME=idrm_db
DB_USER=idrm_user
DB_PASS=idrm_secure_password_2024
DATABASE_URL=postgresql+asyncpg://idrm_user:idrm_secure_password_2024@localhost:5432/idrm_db

# --- Redis 7.2 (cache, sessions, rate limiting, pub/sub) ---
REDIS_URL=redis://localhost:6379/0

# --- JWT authentication (canonical: 15-min access + 7-day refresh) ---
JWT_SECRET_KEY=dev-only-secret-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (the three frontends) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,exp://127.0.0.1:19000

# --- Service ports (reference) ---
BACKEND_PORT=8000
API_GATEWAY_PORT=3000
WEBSOCKET_PORT=3001
