# =============================================================================
# .gitattributes — normalize line endings so the repo behaves the same on
# Windows, macOS, and Linux.
#
# WHY THIS MATTERS: the shell scripts in scripts/ MUST use LF line endings. If
# Git checked them out with Windows CRLF, bash would fail with errors like
# "/usr/bin/env: 'bash\r': No such file or directory". The rules below force LF
# for scripts and let Git auto-handle everything else.
# =============================================================================

# Default: let Git decide text vs binary, and store/checkout text as LF.
* text=auto eol=lf

# Scripts and Unix-y files: always LF.
*.sh   text eol=lf
*.bash text eol=lf

# Windows batch files: always CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary files: never touch line endings.
*.png  binary
*.jpg  binary
*.ico  binary
*.xlsx binary
*.pdf  binary

# Treat docs as documentation in GitHub's language stats (cosmetic).
*.md       linguist-documentation
docs/**    linguist-documentation
