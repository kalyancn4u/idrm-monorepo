# IDRM API Gateway — copy to `.env` and adjust as needed.
# Every value has a safe development default in src/config.ts, so the gateway
# also runs with no .env at all during local development.

# HTTP port the gateway listens on.
PORT=3000

# Where to forward /api/* requests (the FastAPI monolith).
FASTAPI_URL=http://localhost:8000

# Browser origins allowed by CORS (comma-separated). 5173 = HTML/Tailwind, 5174 = React SPA.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,exp://127.0.0.1:19000

# JWT signing secret (G3). 🚩 MUST be byte-for-byte identical to the backend's
# JWT_SECRET_KEY, or every token will fail verification. Override in staging/prod.
JWT_SECRET=dev-only-secret-change-in-production-min-32-chars

# WebSocket server port (a separate server from the HTTP one). ws://localhost:3001
WEBSOCKET_PORT=3001

# Redis URL. Optional in dev: when UNSET, rate limiting uses an in-process store
# and the WebSocket relays nothing (no publisher). Set it to enable G4 real-time
# fan-out and shared (multi-replica) rate-limit counters — point it at the SAME
# Redis the backend publishes to.
# REDIS_URL=redis://localhost:6379/0
