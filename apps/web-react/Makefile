.DEFAULT_GOAL := help
.PHONY: help dev build test lint typecheck clean
help:      ; @echo "dev | build | test | lint | typecheck"
dev:       ; @bun run dev
build:     ; @bun run build
test:      ; @bun run test
lint:      ; @bun run lint
typecheck: ; @bun run typecheck
clean:     ; @rm -rf dist node_modules .turbo
